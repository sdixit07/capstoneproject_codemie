{
  "name": "capstoneproject_codemie",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for the Codemie e-commerce capstone project with a Spring Boot backend and React/Vite frontend.",
  "type": "module",
  "packageManager": "npm@10",
  "workspaces": [
    "ecom-front/ecom-catalog-react"
  ],
  "scripts": {
    "frontend:build": "npm --prefix ./ecom-front/ecom-catalog-react run build",
    "frontend:test": "npm --prefix ./ecom-front/ecom-catalog-react run test",
    "backend:test": "./ecom-project/mvnw -f ./ecom-project/pom.xml test"
  }
}

