# Base URL of the product catalog backend.
# Falls back to http://localhost:8080 when not set.
VITE_API_BASE_URL=http://localhost:8080

# Products per page. Must be between 1 and 50 (the backend rejects anything else).
# Falls back to 10 when unset or out of range. The e2e suite sets this to a small
# value so a modest seed dataset still spans several pages.
VITE_PAGE_SIZE=10
