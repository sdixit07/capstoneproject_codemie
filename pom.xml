        <frontend.entry-point>ecom-front/ecom-catalog-react/src/main.jsx</frontend.entry-point>
        <backend.entry-point>ecom-project/src/main/java/org/ecom/productcatalog/EcomProjectApplication.java</backend.entry-point>
